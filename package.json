{
    "name": "my-bkper-app",
    "private": true,
    "workspaces": [
        "packages/shared",
        "packages/web/client",
        "packages/web/server",
        "packages/events"
    ],
    "scripts": {
        "clean": "bun run --filter \"./packages/**\" clean && rm -rf node_modules dist",
        "predev": "bun install",
        "dev": "node ../bkper-cli/lib/cli.js app dev",
        "prebuild": "bun install",
        "build": "node ../bkper-cli/lib/cli.js app build",
        "deploy": "node ../bkper-cli/lib/cli.js app deploy",
        "deploy:preview": "node ../bkper-cli/lib/cli.js app deploy --preview"
    },
    "devDependencies": {
        "prettier": "^3"
    }
}
